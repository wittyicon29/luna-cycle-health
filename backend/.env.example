DATABASE_URL=postgresql://postgres:postgres@localhost:5432/luna_db
# In production, use a random value of at least 32 characters
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REDIS_URL=redis://localhost:6379/0
HUGGINGFACE_API_KEY=
MEDGEMMA_MODEL=google/medgemma-1.5-4b-it
GROQ_API_KEY=
QWEN_MODEL=qwen/qwen3-32b
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Luna Health

# --- Added for launch hardening ---
FRONTEND_URL=http://localhost:3000
# Comma-separated Fernet keys, newest first. REQUIRED when APP_ENV=production.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the new key first and keep the old one after it until all rows are rewritten.
ENCRYPTION_KEYS=
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=10/minute
CHAT_DAILY_LIMIT=20
PRIVACY_POLICY_VERSION=1.0
SUPPORT_EMAIL=
