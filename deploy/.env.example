# Luna Health production environment template.
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env
# deploy/.env is git-ignored. Never commit it, paste it into chats/tickets, or log it.
# Docker Compose reads it for the ${...} values in deploy/compose.prod.yml and passes it
# to the api and migrate containers.
#
# Lines marked REQUIRED must be filled in; the stack refuses to start without them.
# Every placeholder below is deliberately invalid ("change-me", empty, example.com).
#
# Generating secrets (run on a trusted machine, paste the output here):
#   hex secrets / passwords:  openssl rand -hex 24      (alphanumeric: safe inside URLs)
#   SECRET_KEY:               openssl rand -hex 32
#   Fernet keys:              python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# BACK UP SECRET_KEY, ENCRYPTION_KEYS and BILLING_ACCOUNT_SECRET somewhere safe (password
# manager / offline) BEFORE the first real user signs up. Losing ENCRYPTION_KEYS makes the
# encrypted health data unreadable forever; there is no recovery.

# ==== Compose / proxy / domain ===============================================

# REQUIRED. Public DNS name of the API (an A/AAAA record pointing at this server).
API_DOMAIN=api.example.com
# REQUIRED. Contact address for the Let's Encrypt/ZeroSSL account (expiry notices).
ACME_EMAIL=ops@example.com
# gunicorn worker processes (default 2). Each worker opens up to
# DB_POOL_SIZE + DB_MAX_OVERFLOW database connections; keep the total under Postgres
# max_connections (100 by default).
WEB_CONCURRENCY=2

# ==== Core ===================================================================

# Set to "production" by compose for api/migrate; listed here for completeness.
# Only "development" and "testing" relax the security checks; never use them on a server.
# APP_ENV=production
# Comma-separated origins allowed by CORS (the app's WebView origins and any web frontend).
ALLOWED_ORIGINS=https://localhost,capacitor://localhost
# Base URL used in links inside emails (verification, password reset).
FRONTEND_URL=https://app.example.com
# Version of the privacy policy users must accept; bump when the policy text changes.
PRIVACY_POLICY_VERSION=1.0
# REQUIRED. Address shown to users for support and privacy requests.
SUPPORT_EMAIL=support@example.com

# ==== Database ===============================================================

# REQUIRED. Postgres password for the `luna` user (hex/alphanumeric only: it is put into
# DATABASE_URL unencoded). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Built by compose from POSTGRES_PASSWORD (postgresql://luna:...@db:5432/luna); leave unset.
# DATABASE_URL=
# SQLAlchemy pool per gunicorn worker (see WEB_CONCURRENCY).
DB_POOL_SIZE=10
# Extra connections a worker may open above DB_POOL_SIZE under load.
DB_MAX_OVERFLOW=20
# Recycle pooled connections after this many seconds (avoids stale connections).
DB_POOL_RECYCLE_SECONDS=1800

# ==== Redis (shared rate limits) =============================================

# REQUIRED. Redis password (hex/alphanumeric only: it is put into REDIS_URL unencoded).
# Generate: openssl rand -hex 24
REDIS_PASSWORD=change-me
# Built by compose from REDIS_PASSWORD (redis://:...@redis:6379/0); leave unset.
# REDIS_URL=

# ==== Security / keys ========================================================

# REQUIRED. JWT signing key, at least 32 random characters. Generate: openssl rand -hex 32
# Changing it signs every user out.
SECRET_KEY=change-me
# JWT algorithm; leave as HS256.
ALGORITHM=HS256
# Access-token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh-token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=30
# REQUIRED. Comma-separated Fernet keys, newest first, for field-level encryption of health data.
# Generate with the Fernet command at the top of this file. To rotate, put the new key first
# and keep the old ones after it. BACK THIS UP before real data exists.
ENCRYPTION_KEYS=

# ==== Email (SMTP) ===========================================================

# REQUIRED. SMTP host for verification and password-reset emails.
SMTP_SERVER=smtp.example.com
# SMTP port (587 = STARTTLS submission).
SMTP_PORT=587
# REQUIRED. SMTP username.
SMTP_USER=change-me
# REQUIRED. SMTP password or provider API key.
SMTP_PASSWORD=change-me
# Use STARTTLS (true/false).
SMTP_USE_TLS=true
# Sender address; defaults to SMTP_USER when empty.
SMTP_FROM_EMAIL=no-reply@example.com
# Sender display name.
SMTP_FROM_NAME=Luna Health

# ==== AI providers ===========================================================

# Hugging Face token for the analysis model (empty disables that provider).
HUGGINGFACE_API_KEY=
# Hugging Face model id used for analysis.
MEDGEMMA_MODEL=google/medgemma-1.5-4b-it
# Groq API key for the chat model (empty disables that provider).
GROQ_API_KEY=
# Groq model id used for chat.
QWEN_MODEL=qwen/qwen3-32b

# ==== Google sign-in =========================================================

# Comma-separated Google OAuth Web client IDs accepted as the ID-token audience
# (empty disables Google sign-in with ID tokens).
GOOGLE_ID_TOKEN_AUDIENCES=

# ==== Billing (Google Play) ==================================================

# off | test | google. Keep "off" until the Play Console setup is finished
# (docs/superpowers/billing-owner-checklist.md). Never use "test" in production.
BILLING_MODE=off
# Android application id registered in Play Console (required when BILLING_MODE=google).
GOOGLE_PLAY_PACKAGE_NAME=
# Path INSIDE the container to the Play service-account JSON (required when BILLING_MODE=google;
# mount it read-only, see the commented volume in compose.prod.yml), e.g. /run/secrets/play-service-account.json
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
# Comma-separated Play subscription product ids.
BILLING_PRODUCT_IDS=
# Re-verify an entitlement with Google after this many hours.
BILLING_REVERIFY_AFTER_HOURS=6
# Keep a verified entitlement this many hours while Google is unreachable.
BILLING_OUTAGE_GRACE_HOURS=24
# Key for the Play obfuscated account id (empty falls back to SECRET_KEY). Set it once
# (openssl rand -hex 32) so rotating SECRET_KEY does not change every user's account id.
# BACK THIS UP: changing it detaches existing purchases from their users.
BILLING_ACCOUNT_SECRET=

# ==== Rate limits ============================================================

# Master switch for rate limiting (true/false). Keep true in production.
RATE_LIMIT_ENABLED=true
# Set to "redis" by compose (shared across workers); "memory" is for development only.
# RATE_LIMIT_STORAGE=redis
# Set by compose to the Caddy container's fixed address (172.28.0.10): the only peer whose
# X-Forwarded-For is honoured. Leave unset here; an empty value trusts nobody.
# TRUSTED_PROXY_IPS=
# Per-client limit for login/register/password endpoints.
AUTH_RATE_LIMIT=10/minute
# Per-client limit for chat requests.
CHAT_RATE_LIMIT=10/minute
# Chat messages per user per day.
CHAT_DAILY_LIMIT=20

# ==== Backups (reserved) =====================================================

# Backup settings (schedule, off-site target, encryption) arrive in a later release;
# until then follow the manual backup steps in deploy/README.md.
