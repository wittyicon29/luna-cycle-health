# Settings for scripts/backup_db.sh. Copy to deploy/backup.env (git-ignored), chmod 600,
# and run: scripts/backup_db.sh --env-file deploy/backup.env
# The file is parsed as KEY=value lines (nothing in it is executed); a variable that is
# already set in the environment wins over the file. Placeholders only: no real values here.

# Where the encrypted backups are kept on this host (created with mode 0700).
BACKUP_DIR=/var/backups/luna

# REQUIRED. The age public key (age1...) or SSH public key the backups are encrypted to.
# Generate the key pair on a machine you control: `age-keygen -o luna-backup.key` prints
# the public key; keep luna-backup.key (the private key) OFF this server, in your password
# manager or offline. Without it no backup can ever be restored.
BACKUP_AGE_RECIPIENT=

# compose: run pg_dump inside the db container of deploy/compose.prod.yml (the default
# production setup; no database port or password is needed on the host).
# direct: connect with DATABASE_URL (a managed database, or a drill server).
BACKUP_MODE=compose

# compose mode: the stack's files (paths relative to where cron runs the script, or absolute).
COMPOSE_FILE=deploy/compose.prod.yml
# compose mode: the env file the stack was started with.
COMPOSE_ENV_FILE=deploy/.env
# compose mode: service, user and database name from compose.prod.yml.
COMPOSE_DB_SERVICE=db
# compose mode: database user.
COMPOSE_DB_USER=luna
# compose mode: database name.
COMPOSE_DB_NAME=luna

# direct mode only: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# The script turns it into PGPASSWORD etc.; the password is never put on a command line.
DATABASE_URL=

# Keep at most this many backups...
BACKUP_KEEP_LAST=14
# ...and delete backups older than this many days. The newest backup is never deleted.
BACKUP_KEEP_DAYS=30

# Optional off-site copy, run with `sh -c` after each successful backup: $1 is the
# .dump.age path, $2 the .counts.json path. Example: rclone copy "$1" offsite:luna-backups/
# A failing hook makes the script exit 4 but keeps the local backup.
BACKUP_UPLOAD_CMD=

# Seconds to wait for the database to answer the snapshot/count queries.
BACKUP_SNAPSHOT_TIMEOUT=60

# How long pg_dump waits for a table lock (ms, s or min). A migration's ALTER TABLE during
# the backup would otherwise make the backup hang; with this it fails cleanly (exit 1).
# Do not deploy or migrate while a backup runs.
BACKUP_LOCK_WAIT_TIMEOUT=60s

# 1: print the commands that would run (password redacted) and stop.
DRY_RUN=0
